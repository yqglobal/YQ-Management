# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/yq_queue"

# Redis Configuration (Leave default for local)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Server Configuration
PORT=3000
NODE_ENV="development" # Set to 'production' on Render
TEST_MODE="false"

# Security (JWT and Webhooks)
JWT_SECRET="your_super_secret_jwt_key_at_least_32_chars_long"
WEBHOOK_SECRET="optional_webhook_secret_for_whatsapp"
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=100

# Application URLs (CRITICAL for Emails/QR/SMS/OAuth redirects)
BACKEND_URL="http://localhost:3000"     # e.g., https://qmova-backend.onrender.com
FRONTEND_URL="http://localhost:3001"    # e.g., https://qmova.vercel.app
APP_URL="http://localhost:3001"         # Same as FRONTEND_URL or specific dashboard route
BACKEND_PUBLIC_URL="http://localhost:3000" # Public URL where backend receives webhooks (Render backend URL)

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Brevo (Email Notifications)
BREVO_API_KEY="your_brevo_api_key"
BREVO_LIST_ID=2

# Evolution API (WhatsApp Notifications)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your_evolution_api_key_at_least_16_chars"
EVOLUTION_INSTANCE_NAME="qmova_whatsapp"

# Ozow (Payment Gateway)
OZOW_SITE_CODE="your_ozow_site_code"
OZOW_PRIVATE_KEY="your_ozow_private_key"
OZOW_API_KEY="your_ozow_api_key"