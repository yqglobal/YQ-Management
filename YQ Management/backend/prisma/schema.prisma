generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  OPERATOR
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TokenStatus {
  WAITING
  SERVING
  COMPLETED
  MISSED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
  PAST_DUE
}

enum PaymentProviderName {
  OZOW
}

enum WebhookEventType {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_PENDING
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  MISSED
  PENDING_APPROVAL
  REJECTED
  BLOCKED
}

enum VisitSource {
  APPOINTMENT
  WALK_IN
  WEBSITE
  WHATSAPP
  PHONE
  RECEPTION
  KIOSK
  QR
  API
}

enum VisitState {
  CREATED
  SCHEDULED
  CHECKED_IN
  WAITING
  CALLED
  ASSIGNED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
  MISSED
  ON_HOLD
  ABANDONED
  TRANSFERRED
}

enum PolicyType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  COOKIE_POLICY
  REFUND_POLICY
  DATA_PROCESSING_AGREEMENT
}

model Tenant {
  id                 String  @id @default(uuid())
  name               String
  subdomain          String  @unique // e.g., 'hospitalname'
  branding           Json? // Stores colors, logo URLs
  whatsappInstanceId String? // Optional Evolution API instance name
  whatsappConnected  Boolean @default(false)
  whatsappPhone      String?
  chatbotEnabled     Boolean @default(false)
  chatbotConfig      Json? // Stores custom button menus and automated replies
  customerExperience Json? // Global settings for forms, feedback, and portal experience

  // Google Business Profile Integration

  enableSmartReviews      Boolean   @default(false)
  reviewWaitThresholdMins Int       @default(15)

  appointmentApprovalMode String            @default("AUTO") // AUTO, MANUAL
  users              User[]
  workspaces         Workspace[]
  queues             Queue[]
  transactions       Transaction[]
  webhooks           WebhookEndpoint[]
  webhookEvents      WebhookEvent[]

  customers           Customer[]
  locations           Location[]
  services            Service[]
  staffMembers        Staff[]
  resources           Resource[]
  appointments        Appointment[]
  visits              Visit[]
  enterpriseInquiries EnterpriseInquiry[]
  operatingCountries  String[] @default([])
  chatSessions        ChatSession[]
  customerConversations CustomerConversation[]
  messages            Message[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  usages              TenantUsage[]
  invitations         Invitation[]  // Team invitations scoped to this tenant
  autonomousEnabled   Boolean @default(false)
  createdAt DateTime @default(now())
  
  googleIntegrations  GoogleIntegration[]
}

model User {
  id               String     @id @default(uuid())
  tenantId         String
  workspaceId      String?
  email            String     @unique
  password         String?
  googleId         String?    @unique
  role             Role
  otpCode          String?
  otpExpiresAt     DateTime?
  personalSettings Json?
  
  allowedLocationIds String[] @default([])
  allowedServiceIds  String[] @default([])
  allowedPages       String[] @default([])
  
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  policyAcceptances PolicyAcceptance[]
  cookiePreferences CookiePreference[]
  sessions          UserSession[]
  tokens            Token[]
  operatorVisits    Visit[] @relation("OperatorVisits")

  @@index([tenantId])
  @@index([workspaceId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id         String  @id @default(uuid())
  tenantId   String?
  userId     String?
  customerId String?

  action     String
  resource   String?
  resourceId String?

  endpoint   String?
  method     String?
  statusCode Int?
  durationMs Int?

  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([customerId])
  @@index([action])
  @@index([resource])
}

model Queue {
  id                 String      @id @default(uuid())
  tenantId           String
  workspaceId        String?     // DEPRECATED — kept for legacy compatibility
  locationId         String?     // Which location this queue belongs to
  name               String
  status             QueueStatus
  nextQueueId        String?     // For multi-step routing
  formConfig         Json?       // Dynamic form configuration
  tokenDisplayConfig Json?       // Display settings and token number generation config

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tokens    Token[]
  visits    Visit[]
  services  Service[]  @relation("QueueToService")
  
  frozenByQuota Boolean @default(false)
  frozenAt      DateTime?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([locationId])
}

model Token {
  id           String      @id @default(uuid())
  queueId      String
  customerName String
  phone        String?
  status       TokenStatus
  joinedAt     DateTime    @default(now())

  // Hybrid Appointments
  isAppointment Boolean   @default(false)
  scheduledFor  DateTime?
  checkedIn     Boolean   @default(false)

  // Feedback & CSAT
  rating       Int? // 1-5 star rating
  feedbackText String? // Optional feedback comment

  formResponses Json? // Customer answers to dynamic queue fields
  purpose       String? // Extracted top-level purpose for ETA logic and fast analytics
  language      String  @default("en") // Customer language preference
  displayId     String? // Human-readable token number (e.g. "CC876")

  // Time Tracking (for ETA logic)
  servedAt    DateTime?
  completedAt DateTime?

  queue    Queue     @relation(fields: [queueId], references: [id], onDelete: Cascade)

  operatorId String?
  operator   User?   @relation(fields: [operatorId], references: [id])
  
  reminderSent Boolean @default(false)

  @@index([queueId, status])
  @@index([queueId, joinedAt])
}

model CustomerConversation {
  id            String   @id @default(uuid())
  tenantId      String
  customerPhone String
  status        String   @default("OPEN") // OPEN, CLOSED
  unreadCount   Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([tenantId, customerPhone])
  @@index([tenantId, status])
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String
  customerPhone  String
  visitId        String?
  conversationId String?
  body           String
  sender         String // 'OPERATOR', 'CUSTOMER', 'SYSTEM'
  isRead         Boolean  @default(false)
  whatsappId     String?  @unique
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit          Visit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  conversation   CustomerConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([tenantId, customerPhone])
  @@index([conversationId])
}

model Transaction {
  id                  String   @id @default(uuid())
  tenantId            String
  workspaceId         String?
  transactionRef      String   @unique
  amount              Float
  currency            String   @default("ZAR")
  status              String   @default("PENDING") // PENDING, SUCCESS, CANCELLED, FAILED
  ozowPayRequestId    String?
  rawProviderResponse Json?
  planId              String?
  billingInterval     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workspaceId])
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  tenantId  String
  url       String
  secret    String?
  events    String[] // Array of event names, e.g. ["TOKEN_COMPLETED", "TOKEN_JOINED"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Workspace {
  id                 String   @id @default(uuid())
  tenantId           String
  ownerId            String
  name               String
  subdomain          String   @unique
  branding           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  transactions      Transaction[]
  locations         Location[]
  communicationLogs CommunicationLog[]
  webhookEvents     WebhookEvent[]

  @@index([tenantId])
}

model Plan {
  id              String   @id @default(uuid())
  name            String
  description     String?
  type            String   @default("standard")
  price           Float
  currency        String   @default("ZAR")
  interval        String   @default("monthly")
  billingInterval String   @default("monthly")
  trialDays       Int      @default(0)
  features        Json?
  limits          Json?
  maxVisits       Int?
  maxQueues       Int?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  annualDiscountPercent Int @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId        String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  ozowSubscriptionId String?
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  billingInterval    String             @default("monthly")
  nextBillingDate    DateTime?
  renewalDate        DateTime?
  cancellationDate   DateTime?
  endedAt            DateTime?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@unique([tenantId])
  @@index([tenantId])
}

model PaymentProvider {
  id             String              @id @default(uuid())
  name           PaymentProviderName
  active         Boolean             @default(true)
  config         Json?
  siteCode       String?
  privateKey     String?
  baseUrl        String?
  sandboxEnabled Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Invoice {
  id          String    @id @default(uuid())
  tenantId String
  amount      Float
  currency    String    @default("ZAR")
  status      String    @default("DRAFT")
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantUsage {
  id               String    @id @default(uuid())
  tenantId      String
  tokensUsed       Int       @default(0)
  messagesSent     Int       @default(0)
  branches         Int       @default(0)
  whatsappMessages Int       @default(0)
  aiRequests       Int       @default(0)
  storageBytes     BigInt    @default(0)
  apiCalls         Int       @default(0)
  activeQueues     Int       @default(0)
  queueJoins       Int       @default(0)
  operators        Int       @default(0)
  periodStart      DateTime
  periodEnd        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId])
}

model WhatsAppTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  content     String
  active      Boolean  @default(true)
  isActive    Boolean  @default(true)
  variables   Json?
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id          String   @id @default(uuid())
  tenantId    String
  phone       String
  step        Int      @default(0) // 0: Menu, 1: Book Service, 2: Book Date, 3: Book Slot, etc.
  context     Json?    // To store temporary data (e.g. selected serviceId, date)
  lastActive  DateTime @default(now())
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model CommunicationLog {
  id          String    @id @default(uuid())
  workspaceId String?
  channel     String
  type        String
  recipient   String
  subject     String?
  body        String?
  status      String
  provider    String
  providerId  String?
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Invitation {
  id                 String    @id @default(uuid())
  tenantId           String    // PRIMARY scope — tenant-wide invitations
  workspaceId        String?   // DEPRECATED — kept nullable for legacy reads only
  code               String    @unique
  email              String?
  role               Role      @default(OPERATOR)
  used               Boolean   @default(false)
  usedCount          Int       @default(0)
  maxUses            Int       @default(1)
  usedAt             DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  allowedLocationIds String[]  @default([])
  allowedServiceIds  String[]  @default([])
  allowedPages       String[]  @default([])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([code])
}

model WebhookEvent {
  id               String                  @id @default(uuid())
  tenantId         String
  workspaceId      String?
  transactionId    String?
  eventType        WebhookEventType
  payload          Json
  headers          Json?
  provider         String?
  processingStatus WebhookProcessingStatus @default(PENDING)
  processingResult Json?
  signatureValid   Boolean?
  processedAt      DateTime?
  error            String?
  createdAt        DateTime                @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventType])
  @@index([workspaceId])
  @@index([transactionId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Location {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String?
  name        String
  address     String?
  city        String?
  timezone    String   @default("UTC") // For timezone-aware slot generation
  businessHours Json?
  exceptionDates Json? // e.g. ["2026-12-25"] for holidays
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  services     Service[]
  staff        Staff[]
  resources    Resource[]
  visits       Visit[]
  appointments Appointment[]
  queues       Queue[]

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  googleIntegrationId String?
  googlePlaceId       String?
  googleCalendarId    String?
  googleIntegration   GoogleIntegration? @relation(fields: [googleIntegrationId], references: [id], onDelete: SetNull)

  frozenByQuota Boolean @default(false)
  frozenAt      DateTime?

  @@index([tenantId])
  @@index([workspaceId])
  @@index([googleIntegrationId])
}

model GoogleIntegration {
  id                String   @id @default(uuid())
  tenantId          String
  googleId          String
  email             String
  accessToken       String
  refreshToken      String?
  tokenExpiry       DateTime?
  createdAt         DateTime @default(now())

  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations         Location[] // Locations using this specific Google account
  
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Service {
  id               String   @id @default(uuid())
  tenantId         String
  locationId       String?
  name             String
  description      String?
  expectedDuration Int      @default(30) // in minutes
  bufferDuration   Int      @default(0)  // cleanup/prep time in minutes
  concurrentSlots  Int      @default(1)  // how many simultaneous bookings allowed
  minDuration      Int?
  maxDuration      Int?
  formConfig       Json? // Service-specific forms
  // Future Bookings & Hybrid Queuing
  allowAppointments          Boolean    @default(false)
  requireManualCheckIn       Boolean    @default(false) // If true, customer must click "I have arrived"
  appointmentGranularityMins Int        @default(15) // e.g. 15 mins increments
  avgActualDurationMins      Int?                     // Rolling avg from completed visits (auto-updated)

  // Cascading Scheduling & Availability
  useLocationHours       Boolean    @default(true)
  businessHoursOverride  Json?
  exceptionDatesOverride Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]
  queues       Queue[]  @relation("QueueToService")
  resources    Resource[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  frozenByQuota Boolean @default(false)
  frozenAt      DateTime?

  @@index([tenantId])
  @@index([locationId])
}

model Staff {
  id         String   @id @default(uuid())
  tenantId   String
  locationId String?
  userId     String? // Optional link to User account
  name       String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
  @@index([userId])
}

model Resource {
  id         String   @id @default(uuid())
  tenantId   String
  locationId String?
  name       String
  type       String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]
  services     Service[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
}

model Appointment {
  id             String            @id @default(uuid())
  tenantId       String
  customerId     String?
  locationId     String
  serviceId      String
  staffId        String?
  resourceId     String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus @default(SCHEDULED)
  bookingSource  VisitSource       @default(APPOINTMENT)
  customerNotes  String?
  formData       Json?
  reminderStatus String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  visits Visit[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([locationId])
  @@index([serviceId])
  @@index([scheduledStart])
}

model Visit {
  id                 String      @id @default(uuid())
  tenantId           String
  customerId         String
  locationId         String
  serviceId          String
  appointmentId      String?
  source             VisitSource @default(WALK_IN)
  scheduledTime      DateTime?
  actualArrival      DateTime?
  checkInTime        DateTime?
  waitingStart       DateTime?
  serviceStart       DateTime?
  serviceEnd         DateTime?
  completedAt        DateTime?
  assignedStaffId    String?
  assignedResourceId String?
  currentState       VisitState  @default(CREATED)
  priority           Int         @default(0)
  queueId            String? // Optional reference to a Queue if they are in one
  notes              String?
  metadata           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt


  // Hybrid Queue Fields
  displayId     String? // Human-readable queue number (e.g. "CC876")
  accessToken   String    @unique @default(uuid()) // Opaque capability token
  operatorId    String?
  operatorUser  User?     @relation("OperatorVisits", fields: [operatorId], references: [id])
  language      String    @default("en")
  rating        Int?
  feedbackText  String?
  purpose       String?
  formResponses Json?
  messages      Message[]

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location    Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  resource    Resource?    @relation(fields: [assignedResourceId], references: [id], onDelete: SetNull)
  queue       Queue?       @relation(fields: [queueId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
  @@index([currentState])
  @@index([customerId])
  @@index([queueId])
}

model Policy {
  id        String     @id @default(uuid())
  type      PolicyType
  version   String // e.g., "1.0.0"
  content   String     @db.Text
  active    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  acceptances PolicyAcceptance[]

  @@unique([type, version])
}

model PolicyAcceptance {
  id         String   @id @default(uuid())
  userId     String
  policyId   String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([policyId])
}

model CookiePreference {
  id          String   @id @default(uuid())
  userId      String? // Optional, can be anonymous
  anonymousId String?  @unique // For non-logged in users
  necessary   Boolean  @default(true)
  analytics   Boolean  @default(false)
  functional  Boolean  @default(false)
  marketing   Boolean  @default(false)
  ipAddress   String?
  userAgent   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonymousId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceInfo   Json?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}


model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model SystemLog {
  id         String   @id @default(uuid())
  level      String // INFO, WARN, ERROR
  message    String
  stackTrace String?
  context    Json?
  tenantId   String?
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model EnterpriseInquiry {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  email       String
  companyName String
  phone       String?
  message     String   @db.Text
  status      String   @default("PENDING") // PENDING, CONTACTED, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model Blog {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String    @db.Text
  coverImage     String?
  authorName     String?
  seoTitle       String?
  seoDescription String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([slug])
}

model MarketingSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  source    String   @default("WEBSITE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  
  @@index([email])
}
