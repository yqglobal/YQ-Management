generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                      String                 @id @default(uuid())
  name                    String
  subdomain               String                 @unique
  branding                Json?
  whatsappInstanceId      String?
  whatsappConnected       Boolean                @default(false)
  whatsappPhone           String?
  chatbotEnabled          Boolean                @default(false)
  chatbotConfig           Json?
  customerExperience      Json?
  appointmentApprovalMode String                 @default("AUTO")
  operatingCountries      String[]               @default([])
  autonomousEnabled       Boolean                @default(false)
  createdAt               DateTime               @default(now())
  enableSmartReviews      Boolean                @default(false)
  reviewWaitThresholdMins Int                    @default(15)
  ownerId                 String?
  selfServeModeEnabled    Boolean                @default(false)
  selfServeOtpEnabled     Boolean                @default(true)
  showSupportInfo         Boolean                @default(true)
  supportEmail            String?
  supportPhone            String?
  businessType            String                 @default("general")
  strictPrivacyMode       Boolean                @default(false)
  aiConfig                Json?
  appointments            Appointment[]
  blockOffs               BlockOff[]
  blueprintFlows          BlueprintFlow[]
  bookingPayments         BookingPayment[]
  chatSessions            ChatSession[]
  checkInOtps             CheckInOtp[]
  communicationLogs       CommunicationLog[]
  customers               Customer[]
  customerConversations   CustomerConversation[]
  enterpriseInquiries     EnterpriseInquiry[]
  googleIntegrations      GoogleIntegration[]
  invitations             Invitation[]
  invoices                Invoice[]
  locations               Location[]
  messages                Message[]
  queues                  Queue[]
  resources               Resource[]
  services                Service[]
  slaPolicies             SlaPolicy[]
  staffMembers            Staff[]
  subscriptions           Subscription?
  paymentAccount          TenantPaymentAccount?
  usages                  TenantUsage[]
  transactions            Transaction[]
  users                   User[]
  visits                  Visit[]
  webhooks                WebhookEndpoint[]
  webhookEvents           WebhookEvent[]
  whatsappTemplates       WhatsAppTemplate[]
}

model CheckInOtp {
  id         String   @id @default(uuid())
  tenantId   String
  phone      String
  locationId String?
  code       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([phone, tenantId])
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String?
  googleId           String?            @unique
  role               Role
  otpCode            String?
  otpExpiresAt       DateTime?
  allowedLocationIds String[]           @default([])
  allowedPages       String[]           @default([])
  allowedServiceIds  String[]           @default([])
  personalSettings   Json?
  tenantId           String
  skills             String[]           @default([])
  cookiePreferences  CookiePreference[]
  policyAcceptances  PolicyAcceptance[]
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions           UserSession[]
  operatorVisits     Visit[]            @relation("OperatorVisits")

  @@index([tenantId])
}

model SlaPolicy {
  id                   String    @id @default(uuid())
  tenantId             String
  name                 String
  warningThresholdMins Int
  breachThresholdMins  Int
  escalationPhones     String[]  @default([])
  services             Service[]
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())
  customerId String?
  durationMs Int?
  endpoint   String?
  method     String?
  resource   String?
  resourceId String?
  statusCode Int?
  tenantId   String?
  action     String

  @@index([tenantId])
  @@index([userId])
  @@index([customerId])
  @@index([action])
  @@index([resource])
}

model Queue {
  id                 String      @id @default(uuid())
  name               String
  status             QueueStatus
  nextQueueId        String?
  formConfig         Json?
  locationId         String?
  tenantId           String
  tokenDisplayConfig Json?
  frozenAt           DateTime?
  frozenByQuota      Boolean     @default(false)
  createdAt          DateTime    @default(now())
  maxCapacity        Int?
  blockOffs          BlockOff[]
  location           Location?   @relation(fields: [locationId], references: [id])
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits             Visit[]
  services           Service[]   @relation("QueueToService")

  @@index([tenantId])
  @@index([locationId])
}

model CustomerConversation {
  id            String    @id @default(uuid())
  tenantId      String
  customerPhone String
  status        String    @default("OPEN")
  unreadCount   Int       @default(0)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([tenantId, customerPhone])
  @@index([tenantId, status])
}

model Message {
  id             String                @id @default(uuid())
  body           String
  sender         String
  createdAt      DateTime              @default(now())
  conversationId String?
  customerPhone  String
  isRead         Boolean               @default(false)
  tenantId       String
  visitId        String?
  isDeleted      Boolean               @default(false)
  whatsappId     String?               @unique
  conversation   CustomerConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit          Visit?                @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([tenantId, customerPhone])
  @@index([conversationId])
}

model Transaction {
  id                  String   @id @default(uuid())
  transactionRef      String   @unique
  amount              Float
  currency            String   @default("ZAR")
  status              String   @default("PENDING")
  ozowPayRequestId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  billingInterval     String?
  planId              String?
  rawProviderResponse Json?
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WebhookEndpoint {
  id            String   @id @default(uuid())
  url           String
  secret        String?
  events        String[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  tenantId      String
  payloadFormat String   @default("DEFAULT")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Plan {
  id                    String         @id @default(uuid())
  name                  String
  description           String?
  price                 Float
  currency              String         @default("ZAR")
  trialDays             Int            @default(0)
  features              Json?
  limits                Json?
  sortOrder             Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  active                Boolean        @default(true)
  interval              String         @default("monthly")
  maxQueues             Int?
  maxVisits             Int?
  type                  String         @default("standard")
  billingInterval       String         @default("monthly")
  annualDiscountPercent Int            @default(10)
  subscriptions         Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  renewalDate        DateTime?
  cancellationDate   DateTime?
  nextBillingDate    DateTime?
  endedAt            DateTime?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cancelAtPeriodEnd  Boolean            @default(false)
  ozowSubscriptionId String?
  tenantId           String             @unique
  billingInterval    String             @default("monthly")
  plan               Plan               @relation(fields: [planId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PaymentProvider {
  id             String              @id @default(uuid())
  name           PaymentProviderName
  sandboxEnabled Boolean             @default(true)
  siteCode       String?
  privateKey     String?
  baseUrl        String?
  config         Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  active         Boolean             @default(true)
}

model Invoice {
  id        String    @id @default(uuid())
  amount    Float
  currency  String    @default("ZAR")
  status    String    @default("DRAFT")
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantUsage {
  id               String   @id @default(uuid())
  tenantId         String
  tokensUsed       Int      @default(0)
  messagesSent     Int      @default(0)
  branches         Int      @default(0)
  whatsappMessages Int      @default(0)
  aiRequests       Int      @default(0)
  storageBytes     BigInt   @default(0)
  apiCalls         Int      @default(0)
  activeQueues     Int      @default(0)
  queueJoins       Int      @default(0)
  operators        Int      @default(0)
  periodStart      DateTime
  periodEnd        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId])
}

model WhatsAppTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  content   String
  active    Boolean  @default(true)
  isActive  Boolean  @default(true)
  variables Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ChatSession {
  id         String   @id @default(uuid())
  tenantId   String
  phone      String
  step       Int      @default(0)
  context    Json?
  lastActive DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model CommunicationLog {
  id          String    @id @default(uuid())
  channel     String
  type        String
  recipient   String
  subject     String?
  body        String?
  status      String
  provider    String
  providerId  String?
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  tenantId    String?
  readAt      DateTime?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Invitation {
  id                 String    @id @default(uuid())
  code               String    @unique
  email              String?
  role               Role      @default(OPERATOR)
  maxUses            Int       @default(1)
  usedCount          Int       @default(0)
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  allowedLocationIds String[]  @default([])
  allowedPages       String[]  @default([])
  allowedServiceIds  String[]  @default([])
  used               Boolean   @default(false)
  usedAt             DateTime?
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([code])
}

model WebhookEvent {
  id               String                  @id @default(uuid())
  eventType        WebhookEventType
  transactionId    String?
  payload          Json
  headers          Json?
  signatureValid   Boolean?
  processingStatus WebhookProcessingStatus @default(PENDING)
  processedAt      DateTime?
  createdAt        DateTime                @default(now())
  error            String?
  tenantId         String
  provider         String?
  processingResult Json?
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventType])
  @@index([transactionId])
}

model Customer {
  id           String        @id @default(uuid())
  tenantId     String
  name         String
  phone        String?
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits       Visit[]

  @@index([tenantId])
}

model Location {
  id                  String             @id @default(uuid())
  tenantId            String
  name                String
  address             String?
  city                String?
  timezone            String             @default("UTC")
  businessHours       Json?
  exceptionDates      Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  frozenAt            DateTime?
  frozenByQuota       Boolean            @default(false)
  googleIntegrationId String?
  googlePlaceId       String?
  googleCalendarId    String?
  buildingMap         Json?
  totalFloors         Int?
  appointments        Appointment[]
  blockOffs           BlockOff[]
  googleIntegration   GoogleIntegration? @relation(fields: [googleIntegrationId], references: [id])
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queues              Queue[]
  resources           Resource[]
  services            Service[]
  staff               Staff[]
  visits              Visit[]

  @@index([tenantId])
  @@index([googleIntegrationId])
}

model GoogleIntegration {
  id           String     @id @default(uuid())
  tenantId     String
  googleId     String
  email        String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations    Location[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Service {
  id                         String        @id @default(uuid())
  tenantId                   String
  locationId                 String?
  name                       String
  description                String?
  expectedDuration           Int           @default(30)
  bufferDuration             Int           @default(0)
  concurrentSlots            Int           @default(1)
  minDuration                Int?
  maxDuration                Int?
  formConfig                 Json?
  allowAppointments          Boolean       @default(false)
  requireManualCheckIn       Boolean       @default(false)
  appointmentGranularityMins Int           @default(15)
  avgActualDurationMins      Int?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  businessHoursOverride      Json?
  exceptionDatesOverride     Json?
  useLocationHours           Boolean       @default(true)
  frozenAt                   DateTime?
  frozenByQuota              Boolean       @default(false)
  allowProviderSelection     Boolean       @default(false)
  dateSelectionType          String        @default("calendar")
  maxDaysInAdvance           Int           @default(30)
  emaExpectedDuration        Float?
  slaPolicyId                String?
  requiredSkills             String[]      @default([])
  basePrice                  Float?
  paymentMode                String        @default("NONE")
  priceCurrency              String        @default("ZAR")
  requiresPayment            Boolean       @default(false)
  allowOfflinePayment        Boolean       @default(false)
  appointments               Appointment[]
  location                   Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  slaPolicy                  SlaPolicy?    @relation(fields: [slaPolicyId], references: [id])
  tenant                     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceFlow                ServiceFlow?
  visits                     Visit[]
  queues                     Queue[]       @relation("QueueToService")
  resources                  Resource[]    @relation("ResourceToService")
  staff                      Staff[]       @relation("StaffToService")

  @@index([tenantId])
  @@index([locationId])
}

model Staff {
  id             String        @id @default(uuid())
  tenantId       String
  locationId     String?
  userId         String?
  name           String
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  avatarUrl      String?
  bio            String?
  capacity       Int           @default(1)
  color          String?
  email          String?
  exceptionDates Json?
  phone          String?
  title          String?
  weeklySchedule Json?
  skills         String[]      @default([])
  appointments   Appointment[]
  location       Location?     @relation(fields: [locationId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits         Visit[]
  services       Service[]     @relation("StaffToService")

  @@index([tenantId])
  @@index([locationId])
  @@index([userId])
}

model Resource {
  id           String        @id @default(uuid())
  tenantId     String
  locationId   String?
  name         String
  type         String?
  status       String        @default("ACTIVE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  location     Location?     @relation(fields: [locationId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits       Visit[]
  services     Service[]     @relation("ResourceToService")

  @@index([tenantId])
  @@index([locationId])
}

model Appointment {
  id                     String            @id @default(uuid())
  tenantId               String
  customerId             String?
  locationId             String
  serviceId              String
  staffId                String?
  resourceId             String?
  scheduledStart         DateTime
  scheduledEnd           DateTime
  status                 AppointmentStatus @default(SCHEDULED)
  bookingSource          VisitSource       @default(APPOINTMENT)
  customerNotes          String?
  formData               Json?
  reminderStatus         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  accompanyingGuests     Int               @default(0)
  paymentStatus          String            @default("NOT_REQUIRED")
  pendingPaymentIntentId String?
  requiresPayment        Boolean           @default(false)
  customer               Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location               Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource               Resource?         @relation(fields: [resourceId], references: [id])
  service                Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff                  Staff?            @relation(fields: [staffId], references: [id])
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingPayments        BookingPayment[]
  visits                 Visit[]

  @@index([tenantId])
  @@index([customerId])
  @@index([locationId])
  @@index([serviceId])
  @@index([scheduledStart])
}

model Visit {
  id                 String           @id @default(uuid())
  tenantId           String
  customerId         String
  locationId         String
  serviceId          String
  appointmentId      String?
  source             VisitSource      @default(WALK_IN)
  scheduledTime      DateTime?
  actualArrival      DateTime?
  checkInTime        DateTime?
  waitingStart       DateTime?
  serviceStart       DateTime?
  serviceEnd         DateTime?
  completedAt        DateTime?
  assignedStaffId    String?
  assignedResourceId String?
  currentState       VisitState       @default(CREATED)
  priority           Int              @default(0)
  queueId            String?
  notes              String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  displayId          String?
  accessToken        String           @unique @default(uuid())
  operatorId         String?
  language           String           @default("en")
  rating             Int?
  feedbackText       String?
  purpose            String?
  formResponses      Json?
  cancelReason       String?
  cancelledBy        String?
  accompanyingGuests Int              @default(0)
  itinerary          Json?
  tags               String[]         @default([])
  slaStatus          String           @default("OK")
  surveySent         Boolean          @default(false)
  currentStepId      String?
  flowId             String?
  flowStatus         String           @default("NOT_STARTED")
  bookingPayments    BookingPayment[]
  messages           Message[]
  appointment        Appointment?     @relation(fields: [appointmentId], references: [id])
  resource           Resource?        @relation(fields: [assignedResourceId], references: [id])
  staff              Staff?           @relation(fields: [assignedStaffId], references: [id])
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  flow               ServiceFlow?     @relation(fields: [flowId], references: [id])
  location           Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  operatorUser       User?            @relation("OperatorVisits", fields: [operatorId], references: [id])
  queue              Queue?           @relation(fields: [queueId], references: [id])
  service            Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitSteps         VisitStep[]

  @@index([tenantId])
  @@index([locationId])
  @@index([currentState])
  @@index([customerId])
  @@index([queueId])
  @@index([flowId])
}

model Policy {
  id          String             @id @default(uuid())
  type        PolicyType
  version     String
  content     String
  active      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  acceptances PolicyAcceptance[]

  @@unique([type, version])
}

model PolicyAcceptance {
  id         String   @id @default(uuid())
  userId     String
  policyId   String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([policyId])
}

model CookiePreference {
  id          String   @id @default(uuid())
  userId      String?
  anonymousId String?  @unique
  necessary   Boolean  @default(true)
  analytics   Boolean  @default(false)
  functional  Boolean  @default(false)
  marketing   Boolean  @default(false)
  ipAddress   String?
  userAgent   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonymousId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceInfo   Json?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("PENDING")
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model SystemLog {
  id         String   @id @default(uuid())
  level      String
  message    String
  stackTrace String?
  context    Json?
  tenantId   String?
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model EnterpriseInquiry {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  email       String
  companyName String
  phone       String?
  message     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Blog {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  coverImage     String?
  authorName     String?
  seoTitle       String?
  seoDescription String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
}

model MarketingSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  source    String   @default("WEBSITE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}

model BlockOff {
  id         String    @id @default(uuid())
  tenantId   String
  locationId String?
  queueId    String?
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  queue      Queue?    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startTime])
  @@index([locationId])
  @@index([queueId])
}

model ServiceFlow {
  id                     String             @id @default(uuid())
  tenantId               String
  serviceId              String             @unique
  name                   String
  description            String?
  isActive               Boolean            @default(true)
  allowPartialCompletion Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  steps                  FlowStepTemplate[]
  service                Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  visits                 Visit[]

  @@index([tenantId])
}

model FlowStepTemplate {
  id                         String               @id @default(uuid())
  flowId                     String
  stepOrder                  Int
  name                       String
  description                String?
  type                       StepType             @default(SERVICE)
  trigger                    StepTrigger          @default(MANUAL_STAFF)
  serviceId                  String?
  queueId                    String?
  isOptional                 Boolean              @default(false)
  isRepeatable               Boolean              @default(false)
  requiresQrScan             Boolean              @default(true)
  requiresStaffAction        Boolean              @default(true)
  prerequisites              Json?
  deferredByDays             Int?
  deferredByHours            Int?
  expiresAfterDays           Int?
  entitlementUnit            String?
  entitlementFixed           Int?
  entitlementFormula         String?
  allowPartialRedemption     Boolean              @default(false)
  preventDoubleRedemption    Boolean              @default(true)
  customerInstruction        String?
  staffInstruction           String?
  locationDescription        String?
  floorNumber                Int?
  roomNumber                 String?
  buildingWing               String?
  mapImageUrl                String?
  notifyCustomerOnActivation Boolean              @default(true)
  notificationTemplate       String?
  notifyStaffOnActivation    Boolean              @default(false)
  stepPrice                  Float?
  stepPriceCurrency          String               @default("ZAR")
  isPriceVariable            Boolean              @default(false)
  outcomeOptions             Json?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  flow                       ServiceFlow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  transitions                FlowStepTransition[] @relation("FromStep")
  visitSteps                 VisitStep[]

  @@index([flowId])
  @@index([serviceId])
}

model FlowStepTransition {
  id         String           @id @default(uuid())
  fromStepId String
  toStepId   String?
  flowId     String
  condition  Json?
  label      String?
  priority   Int              @default(0)
  isDefault  Boolean          @default(false)
  fromStep   FlowStepTemplate @relation("FromStep", fields: [fromStepId], references: [id], onDelete: Cascade)

  @@index([fromStepId])
  @@index([flowId])
}

model VisitStep {
  id                String           @id @default(uuid())
  visitId           String
  templateStepId    String
  tenantId          String
  stepOrder         Int
  name              String
  type              StepType
  status            VisitStepStatus  @default(LOCKED)
  serviceId         String?
  queueId           String?
  assignedStaffId   String?
  unlockedAt        DateTime?
  deferredUntil     DateTime?
  expiresAt         DateTime?
  queuedAt          DateTime?
  activatedAt       DateTime?
  completedAt       DateTime?
  skippedAt         DateTime?
  quantityAllocated Int?
  quantityRedeemed  Int              @default(0)
  lastRedeemedAt    DateTime?
  lastRedeemedBy    String?
  outcome           String?
  staffNotes        String?
  amountCharged     Float?
  paymentRef        String?
  paymentStatus     String?
  isSkipped         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  bookingPayments   BookingPayment[]
  templateStep      FlowStepTemplate @relation(fields: [templateStepId], references: [id], onDelete: Cascade)
  visit             Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  events            VisitStepEvent[]

  @@index([visitId])
  @@index([tenantId])
  @@index([status])
  @@index([templateStepId])
}

model VisitStepEvent {
  id          String        @id @default(uuid())
  visitStepId String
  visitId     String
  tenantId    String
  eventType   StepEventType
  actorType   String
  actorId     String?
  payload     Json?
  notes       String?
  createdAt   DateTime      @default(now())
  visitStep   VisitStep     @relation(fields: [visitStepId], references: [id], onDelete: Cascade)

  @@index([visitStepId])
  @@index([visitId])
  @@index([tenantId])
}

model TenantPaymentAccount {
  id                    String           @id @default(uuid())
  tenantId              String           @unique
  provider              String           @default("stripe")
  connectedAccountId    String?
  accountStatus         String           @default("NOT_CONNECTED")
  onboardingCompletedAt DateTime?
  stripeOnboardingUrl   String?
  chargesEnabled        Boolean          @default(false)
  payoutsEnabled        Boolean          @default(false)
  detailsSubmitted      Boolean          @default(false)
  currentlyDue          Json?
  eventuallyDue         Json?
  pendingVerification   Json?
  platformFeePercent    Float?
  platformFeeFixed      Float?
  feeMode               String           @default("PERCENT")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  currency              String           @default("ZAR")
  payments              BookingPayment[]
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
}

model BookingPayment {
  id                      String                @id @default(uuid())
  tenantId                String
  tenantPaymentAccountId  String?
  appointmentId           String?
  visitId                 String?
  visitStepId             String?
  customerId              String?
  amount                  Float
  platformFeeAmount       Float
  tenantNetAmount         Float
  currency                String                @default("ZAR")
  status                  BookingPaymentStatus  @default(PENDING)
  stripePaymentIntentId   String?               @unique
  stripeChargeId          String?
  stripePaymentMethodType String?
  description             String?
  receiptUrl              String?
  metadata                Json?
  refundedAmount          Float                 @default(0)
  refundedAt              DateTime?
  refundReason            String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  appointment             Appointment?          @relation(fields: [appointmentId], references: [id])
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentAccount          TenantPaymentAccount? @relation(fields: [tenantPaymentAccountId], references: [id])
  visit                   Visit?                @relation(fields: [visitId], references: [id])
  visitStep               VisitStep?            @relation(fields: [visitStepId], references: [id])

  @@index([tenantId])
  @@index([tenantPaymentAccountId])
  @@index([appointmentId])
  @@index([visitId])
  @@index([stripePaymentIntentId])
}

model BlueprintFlow {
  id            String          @id @default(uuid())
  key           String          @unique
  name          String
  description   String?
  businessTypes String[]        @default([])
  tenantId      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps         BlueprintStep[]

  @@index([tenantId])
}

model BlueprintStep {
  id                         String        @id @default(uuid())
  blueprintId                String
  stepOrder                  Int
  name                       String
  description                String?
  type                       StepType      @default(SERVICE)
  trigger                    StepTrigger   @default(MANUAL_STAFF)
  isOptional                 Boolean       @default(false)
  requiresQrScan             Boolean       @default(true)
  requiresStaffAction        Boolean       @default(true)
  deferredByDays             Int?
  deferredByHours            Int?
  entitlementUnit            String?
  entitlementFixed           Int?
  entitlementFormula         String?
  allowPartialRedemption     Boolean       @default(false)
  preventDoubleRedemption    Boolean       @default(true)
  customerInstruction        String?
  staffInstruction           String?
  locationDescription        String?
  notifyCustomerOnActivation Boolean       @default(true)
  outcomeOptions             String[]      @default([])
  stepPrice                  Float?
  isPriceVariable            Boolean       @default(false)
  blueprint                  BlueprintFlow @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}

