generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  OPERATOR
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TokenStatus {
  WAITING
  SERVING
  COMPLETED
  MISSED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
  PAST_DUE
}

enum PaymentProviderName {
  OZOW
}

enum WebhookEventType {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_PENDING
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  MISSED
}

enum VisitSource {
  APPOINTMENT
  WALK_IN
  WEBSITE
  WHATSAPP
  PHONE
  RECEPTION
  KIOSK
  QR
  API
}

enum VisitState {
  CREATED
  SCHEDULED
  CHECKED_IN
  WAITING
  CALLED
  ASSIGNED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
  MISSED
  ON_HOLD
  ABANDONED
  TRANSFERRED
}

model Tenant {
  id                 String            @id @default(uuid())
  name               String
  subdomain          String            @unique // e.g., 'hospitalname'
  branding           Json? // Stores colors, logo URLs
  whatsappInstanceId String? // Optional Evolution API instance name
  whatsappConnected  Boolean           @default(false)
  whatsappPhone      String?
  chatbotEnabled     Boolean           @default(false)
  chatbotConfig      Json? // Stores custom button menus and automated replies
  subscriptionStatus String            @default("TRIAL") // TRIAL, ACTIVE, EXPIRED
  users              User[]
  workspaces         Workspace[]
  queues             Queue[]
  transactions       Transaction[]
  webhooks           WebhookEndpoint[]
  webhookEvents      WebhookEvent[]

  customers    Customer[]
  locations    Location[]
  services     Service[]
  staffMembers Staff[]
  resources    Resource[]
  appointments Appointment[]
  visits       Visit[]

  createdAt DateTime @default(now())
}

model User {
  id               String     @id @default(uuid())
  tenantId         String
  workspaceId      String?
  email            String     @unique
  password         String?
  googleId         String?    @unique
  role             Role
  otpCode          String?
  otpExpiresAt     DateTime?
  personalSettings Json?
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workspaceId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id         String  @id @default(uuid())
  tenantId   String?
  userId     String?
  customerId String?

  action     String
  resource   String?
  resourceId String?

  endpoint   String?
  method     String?
  statusCode Int?
  durationMs Int?

  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([customerId])
  @@index([action])
  @@index([resource])
}

model Queue {
  id                 String      @id @default(uuid())
  tenantId           String
  workspaceId        String?
  name               String
  status             QueueStatus
  nextQueueId        String? // For multi-step routing (e.g. Registration -> Billing)
  formConfig         Json? // Dynamic form configuration
  tokenDisplayConfig Json? // Display settings and token number generation config

  // Future Bookings & Hybrid Queuing
  allowAppointments          Boolean    @default(false)
  requireManualCheckIn       Boolean    @default(false) // If true, customer must click "I have arrived"
  appointmentGranularityMins Int        @default(15) // e.g. 15 mins increments
  tenant                     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace                  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokens                     Token[]
  visits                     Visit[]

  @@index([tenantId])
}

model Token {
  id           String      @id @default(uuid())
  queueId      String
  customerName String
  phone        String?
  status       TokenStatus
  joinedAt     DateTime    @default(now())

  // Hybrid Appointments
  isAppointment Boolean   @default(false)
  scheduledFor  DateTime?
  checkedIn     Boolean   @default(false)

  // Feedback & CSAT
  rating       Int? // 1-5 star rating
  feedbackText String? // Optional feedback comment

  formResponses Json? // Customer answers to dynamic queue fields
  purpose       String? // Extracted top-level purpose for ETA logic and fast analytics
  language      String  @default("en") // Customer language preference
  displayId     String? // Human-readable token number (e.g. "CC876")

  // Time Tracking (for ETA logic)
  servedAt    DateTime?
  completedAt DateTime?

  queue    Queue     @relation(fields: [queueId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([queueId, status])
  @@index([queueId, joinedAt])
}

model Message {
  id        String   @id @default(uuid())
  tokenId   String
  body      String
  sender    String // 'OPERATOR' or 'CUSTOMER'
  createdAt DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id])

  @@index([tokenId])
}

model Transaction {
  id                  String   @id @default(uuid())
  tenantId            String
  workspaceId         String?
  transactionRef      String   @unique
  amount              Float
  currency            String   @default("ZAR")
  status              String   @default("PENDING") // PENDING, SUCCESS, CANCELLED, FAILED
  ozowPayRequestId    String?
  rawProviderResponse Json?
  planId              String?
  billingInterval     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workspaceId])
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  tenantId  String
  url       String
  secret    String?
  events    String[] // Array of event names, e.g. ["TOKEN_COMPLETED", "TOKEN_JOINED"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Workspace {
  id                 String   @id @default(uuid())
  tenantId           String
  ownerId            String
  name               String
  subdomain          String   @unique
  branding           Json?
  subscriptionStatus String   @default("TRIAL")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User[]
  queues        Queue[]
  subscriptions Subscription[]
  invoices      Invoice[]
  usages        WorkspaceUsage[]
  transactions  Transaction[]
  locations         Location[]
  communicationLogs CommunicationLog[]
  invitations       Invitation[]
  webhookEvents     WebhookEvent[]

  @@index([tenantId])
}

model Plan {
  id              String   @id @default(uuid())
  name            String
  description     String?
  type            String   @default("standard")
  price           Float
  currency        String   @default("ZAR")
  interval        String   @default("monthly")
  billingInterval String   @default("monthly")
  trialDays       Int      @default(0)
  features        Json?
  limits          Json?
  maxTokens       Int?
  maxQueues       Int?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  workspaceId        String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  ozowSubscriptionId String?
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  billingInterval    String             @default("monthly")
  nextBillingDate    DateTime?
  renewalDate        DateTime?
  cancellationDate   DateTime?
  endedAt            DateTime?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@unique([workspaceId])
  @@index([workspaceId])
}

model PaymentProvider {
  id             String              @id @default(uuid())
  name           PaymentProviderName
  active         Boolean             @default(true)
  config         Json?
  siteCode       String?
  privateKey     String?
  baseUrl        String?
  sandboxEnabled Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Invoice {
  id          String    @id @default(uuid())
  workspaceId String
  amount      Float
  currency    String    @default("ZAR")
  status      String    @default("DRAFT")
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceUsage {
  id               String    @id @default(uuid())
  workspaceId      String
  tokensUsed       Int       @default(0)
  messagesSent     Int       @default(0)
  branches         Int       @default(0)
  whatsappMessages Int       @default(0)
  aiRequests       Int       @default(0)
  storageBytes     BigInt    @default(0)
  apiCalls         Int       @default(0)
  activeQueues     Int       @default(0)
  queueJoins       Int       @default(0)
  operators        Int       @default(0)
  periodStart      DateTime
  periodEnd        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart, periodEnd])
  @@index([workspaceId])
}

model WhatsAppTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  content     String
  active      Boolean  @default(true)
  isActive    Boolean  @default(true)
  variables   Json?
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommunicationLog {
  id          String    @id @default(uuid())
  workspaceId String?
  channel     String
  type        String
  recipient   String
  subject     String?
  body        String?
  status      String
  provider    String
  providerId  String?
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Invitation {
  id          String    @id @default(uuid())
  workspaceId String
  code        String    @unique
  email       String?
  role        Role      @default(OPERATOR)
  used        Boolean   @default(false)
  usedCount   Int       @default(0)
  maxUses     Int       @default(1)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookEvent {
  id               String                  @id @default(uuid())
  tenantId         String
  workspaceId      String?
  transactionId    String?
  eventType        WebhookEventType
  payload          Json
  headers          Json?
  provider         String?
  processingStatus WebhookProcessingStatus @default(PENDING)
  processingResult Json?
  signatureValid   Boolean?
  processedAt      DateTime?
  error            String?
  createdAt        DateTime                @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventType])
  @@index([workspaceId])
  @@index([transactionId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Location {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String?
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services     Service[]
  staff        Staff[]
  resources    Resource[]
  visits       Visit[]
  appointments Appointment[]

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workspaceId])
}

model Service {
  id               String   @id @default(uuid())
  tenantId         String
  locationId       String?
  name             String
  description      String?
  expectedDuration Int      @default(30) // in minutes
  minDuration      Int?
  maxDuration      Int?
  formConfig       Json? // Service-specific forms
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([locationId])
}

model Staff {
  id         String   @id @default(uuid())
  tenantId   String
  locationId String?
  userId     String? // Optional link to User account
  name       String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
  @@index([userId])
}

model Resource {
  id         String   @id @default(uuid())
  tenantId   String
  locationId String?
  name       String
  type       String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
}

model Appointment {
  id             String            @id @default(uuid())
  tenantId       String
  customerId     String
  locationId     String
  serviceId      String
  staffId        String?
  resourceId     String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus @default(SCHEDULED)
  bookingSource  VisitSource       @default(APPOINTMENT)
  customerNotes  String?
  formData       Json?
  reminderStatus String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  visits Visit[]

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([locationId])
  @@index([serviceId])
  @@index([scheduledStart])
}

model Visit {
  id                 String      @id @default(uuid())
  tenantId           String
  customerId         String
  locationId         String
  serviceId          String
  appointmentId      String?
  source             VisitSource @default(WALK_IN)
  scheduledTime      DateTime?
  actualArrival      DateTime?
  checkInTime        DateTime?
  waitingStart       DateTime?
  serviceStart       DateTime?
  serviceEnd         DateTime?
  completedAt        DateTime?
  assignedStaffId    String?
  assignedResourceId String?
  currentState       VisitState  @default(CREATED)
  priority           Int         @default(0)
  queueId            String? // Optional reference to a Queue if they are in one
  notes              String?
  metadata           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location    Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  resource    Resource?    @relation(fields: [assignedResourceId], references: [id], onDelete: SetNull)
  queue       Queue?       @relation(fields: [queueId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
  @@index([currentState])
  @@index([customerId])
  @@index([queueId])
}
