# Production Environment Variables

# Base Domain (e.g. qmova.yqbuddy.com)
DOMAIN_BASE=qmova.yqbuddy.com

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=yq_queue

# Security
JWT_SECRET=generate_a_random_secure_string_here
WEBHOOK_SECRET=generate_a_random_webhook_secret_here

# Third-Party Integrations
SUPER_ADMIN_EMAIL=yqbuddysa@gmail.com
BREVO_API_KEY=your_brevo_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Evolution API (WhatsApp)
# Generate a strong API key for Evolution internal auth
EVOLUTION_API_KEY=generate_a_random_evolution_api_key_here
